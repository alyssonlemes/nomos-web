# Exemplo de variáveis de ambiente para produção
# Copie para `.env` ou use seu gerenciador de segredos (não comitar valores sensíveis)

# --- Server ---
NODE_ENV=production
PORT=3000

# --- Client / Vite ---
# URL base da API (backend)
VITE_API_URL=https://api.seu-dominio.com

# OAuth / Autenticação
# URL do portal de OAuth (onde o usuário faz login)
VITE_OAUTH_PORTAL_URL=https://auth.seu-dominio.com
# ID da aplicação registrado no portal de OAuth
VITE_APP_ID=seu-app-id

# Analytics (Umami)
# Endpoint do servidor de analytics (script será carregado como: <endpoint>/umami)
VITE_ANALYTICS_ENDPOINT=https://analytics.seu-dominio.com
# ID do site no painel de analytics
VITE_ANALYTICS_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Google Maps / Forge proxy
# Chave usada pelo proxy de mapas (ex: Google Maps API key)
VITE_FRONTEND_FORGE_API_KEY=your-google-maps-api-key
# URL do serviço Forge usado como proxy para mapas
VITE_FRONTEND_FORGE_API_URL=https://forge.seu-dominio.com

# --- Observações ---
# - Variáveis que começam com VITE_ são incorporadas ao bundle do frontend.
#   Não coloque segredos sensíveis que não devam ficar públicos no frontend.
# - Para segredos do backend (tokens, DB URLs, etc.), use um gerenciador de segredos
#   e não versionar esses valores no repositório.
# - Ajuste valores e adicione variáveis extras conforme necessário (SENTRY_DSN, DATABASE_URL, etc.).
