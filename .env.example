# Exemplo de variáveis de ambiente para produção (Render)
# Copie para `.env` ou configure no dashboard do Render (não comitar valores sensíveis)

# --- Server ---
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# --- Client / Vite ---
# URL pública da API no Render, SEM barra no final.
# Variáveis VITE_ entram no bundle na hora do build — defina no Render antes de gerar o front.
VITE_API_URL=https://nomos-api.onrender.com

# OAuth / Autenticação (opcional — só se usar o portal OAuth)
# VITE_OAUTH_PORTAL_URL=https://auth.seu-dominio.com
# VITE_APP_ID=seu-app-id

# Analytics (Umami) — opcional
# VITE_ANALYTICS_ENDPOINT=https://analytics.seu-dominio.com
# VITE_ANALYTICS_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Google Maps / Forge proxy — opcional
# VITE_FRONTEND_FORGE_API_KEY=your-google-maps-api-key
# VITE_FRONTEND_FORGE_API_URL=https://forge.seu-dominio.com

# --- Observações ---
# - Variáveis que começam com VITE_ são incorporadas ao bundle do frontend.
#   Não coloque segredos que não devam ficar públicos.
# - O banco de dados continua no Neon e é configurado só na API (DATABASE_URL).
